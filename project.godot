; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Co-op Framework"
config/description="Framework for GDC's co-op game jam."
run/main_scene="uid://bsket3o1le7p1"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://dh0ramf8bubv3"

[autoload]

CoopInput="*uid://da1s3btexev0d"
Cameras="*uid://cg2wie38365tq"

[display]

window/size/mode=3
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://Example Game/": "red",
"res://Framework/": "gray",
"res://Framework/Input Handling/": "purple",
"res://Framework/Player Select Screen/": "blue",
"res://Framework/Splitscreen/": "orange",
"res://YOUR GAME/": "green"
}

